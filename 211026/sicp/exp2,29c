#lang racket


(define (make-mobile left right)
  (list left right))

(define (make-branch length structure)
  (list length structure))

; mobil sol kolunu dondurmek icin

(define (left-branch mobile)
  (car mobile))

; mobilin sag kolunu dondurmek icin

(define (right-branch mobile)
  (cadr mobile))

; total kol uzunlugu icin

(define (branch-length branch)
  (car branch))

; kolun ucundaki yapiyi dondurur

(define (branch-structure branch)
  (cadr branch))


(define sol-dal (make-branch 6 10))
(define sag-dal (make-branch 4 15))

(define ornek-mobil (make-mobile sol-dal sag-dal))



; total weight hesaplamak icin kol ucundaki agirligi hesaplayan bir fonksiyon

(define (branch-weight branch)
  (let ((struct (branch-structure branch)))
    (if (pair? struct)
        (total-weight struct)
        struct)))


; total agirligi hesaplamak icin

(define (total-weight mobile)
  (+ (branch-weight (left-branch mobile))
     (branch-weight (right-branch mobile))))

; iki dal agirligini toplayacak

(define m1 (make-mobile (make-branch 6 10)
                        (make-branch 4 15)))

(define m2 (make-mobile (make-branch 5 m1)
                        (make-branch 3 20)))


; tork hesaplamasi yaptiracagiz (uzunluk x agirlik = tork)


(define (branch-torque branch)
  (* (branch-length branch)
     (branch-weight branch)))


; dengeli (balanced) olup olmadigini kontrol edecegiz

(define (balanced? mobile)
  (let ((left (left-branch mobile))
        (right (right-branch mobile)))
    (and (= (branch-torque left)
            (branch-torque right))
         (branch-balanced? left)
         (branch-balanced? right))))

(define (branch-balanced? branch)
  (let ((struct (branch-structure branch)))
    (if(pair? struct)
       (balanced? struct)
       #t)))

(define mobil-balanced (make-mobile (make-branch 4 6)
                                    (make-branch 2 12)))

(define mobil-unbalanced (make-mobile (make-branch 5 10)
                                     (make-branch 4 15)))

(define mobil-karma-dengeli (make-mobile (make-branch 10 mobil-balanced)
                                         (make-branch 9 20)))

(define mobil-hidden-unbalanced(make-mobile(make-branch 4 mobil-unbalanced)
                                           (make-branch 10 10)))



